    {
      "id": "opening-question",
      "role": "objective",
      "label": "Can disposing of written thoughts reduce anger?",
      "anchors": [
        {
          "page": 1,
          "text": "This study shows that physical disposal of a piece of paper containing one’s written thoughts on the cause of a provocative event neutralises anger, while holding the paper did not.",
