    {
      "id": "code-distinct",
      "role": "result",
      "label": "Different brain responses to syntax and meaning",
      "anchors": [
        {
          "page": 1,
          "text": "At the group level, results showed \nthat manipulations of form resulted in P600 effects, with syntactically invalid code generating more \npositive deflections in the 500–800 ms range than syntactically valid code. Meaning manipulations \nresulted in N400 effects, with semantically implausible code generating more negative deflections in \nthe 300–500 ms range than semantically plausible code.",
          "boxes": [
