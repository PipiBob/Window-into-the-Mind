      "id": "code-trial",
      "role": "method",
      "label": "What programmers did in each trial",
      "anchors": [
        {
          "page": 2,
          "text": "Each trial began with the presentation of a global variable on the screen for 15 s. Afterward, \na single line of code was presented incrementally, on an item-by-item basis.",
          "boxes": [
            [
              0.3707044,
              0.54718311,
              0.93105313,
              0.5627015
            ],
            [
