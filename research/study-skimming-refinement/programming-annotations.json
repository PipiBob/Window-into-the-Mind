              0.55996363,
              0.72229504,
              0.57548202
            ]
          ]
        },
        {
          "page": 2,
          "text": "Participants were asked to read the code for comprehension and make a \nbehavioral response about its “acceptability” (a term that was left intentionally vague to prevent biasing attention \ntoward syntactic versus semantic aspects of the code) afterward.",
          "boxes": [
            [
