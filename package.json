{
  "name": "window-into-the-mind",
  "version": "0.4.1",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "assets": "node scripts/frontend/prepare-assets.mjs",
    "predev": "npm run assets",
    "dev": "vite",
    "prebuild": "npm run assets",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "node research/phase-4/tests/selection.mjs && node research/phase-4/tests/sha256.mjs && node --test scripts/frontend/assets.test.mjs",
    "test:browser": "node scripts/frontend/test-browser.mjs",
    "build:pages": "node scripts/frontend/prepare-assets.mjs --pages && npm run typecheck && vite build --mode pages"
  },
  "dependencies": {
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "typescript": "^5.9.0",
    "vite": "^7.2.0"
  }
}
